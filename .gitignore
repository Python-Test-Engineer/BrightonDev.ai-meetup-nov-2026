# ===========================================================
# Secrets / local config (never commit)
# ===========================================================
.env
.env*
**/.env
**/.env.local
**/.env.*.local

# The template is tracked on purpose - it holds placeholders only.
!.env.example

# Local key dumps from other tooling
OPENROUTER.txt
HERMES-KEYS.md

# ===========================================================
# Node (mini-coding-js)
# ===========================================================
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo

# ===========================================================
# Python / uv
# ===========================================================
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ===========================================================
# Data / live snapshots (generated, not tracked)
# ===========================================================
web_app/data/
live_bikeshare_*.csv
*.db
*.sqlite3

# Agent sandbox output - uncomment to keep demo artefacts out of git
# (the .gitkeep placeholder stays tracked)
#mini-coding-js/workspace/*
#!mini-coding-js/workspace/.gitkeep

# ===========================================================
# Editor / OS / temp
# ===========================================================
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
*.log