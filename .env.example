# Copy to .env in the repo root and fill in. Never commit the real key.
# Read by mini-coding-js/src/config.js, which walks up from
# mini-coding-js/ and uses the nearest .env (the root one).
#
# PRECEDENCE: --model flag  >  .env  >  your shell environment.
# Variables set in .env WIN over the same name exported in the shell; anything
# not mentioned in .env still comes from the shell.

# ---- Required ------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_KEY also works as an alias.

# ---- Model ---------------------------------------------------------------
# Canonical name is OPENROUTER_MODEL; MODEL= is accepted as an alias.
# A bare name (deepseek-v4.1-flash-1017, gpt-5) is normalised to vendor/model.
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
# OPENROUTER_PROVIDER_PREFIX=openai
#   Only needed to force a vendor when the bare-name guess is wrong.

# ---- Agent behaviour -----------------------------------------------------
# CMD_POLICY: allow | ask | deny   (default ask)
#   allow - run the shell commands the model asks for, no prompt
#   ask   - prompt before every command
#   deny  - never run shell commands
CMD_POLICY=ask

# MAX_STEPS: ReAct iterations before the loop gives up (default 12)
#MAX_STEPS=12

# REQUEST_TIMEOUT_MS: per model call, so a stalled request stops (default 90000)
#REQUEST_TIMEOUT_MS=90000

# WORKSPACE_DIR: the only folder the file tools may write to (default workspace)
#WORKSPACE_DIR=workspace
