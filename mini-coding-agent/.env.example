# Copy to .env and fill in. Never commit the real key.
# Place in root of the repo. This is used by the mini-coding-agent to access OpenRouter.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
# `MODEL=` also works as an alias for OPENROUTER_MODEL
# These values WIN over the same variables exported in your shell.
# allow | ask | deny
CMD_POLICY=ask
